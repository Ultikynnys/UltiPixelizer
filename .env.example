# UltiPixelizer build-time environment.
#
# Copy this file to `.env` (gitignored) for local overrides. Vite exposes
# variables prefixed with VITE_ to the frontend at build time via
# import.meta.env. In CI all three are injected by the workflows — do not
# commit real values here.

# Build number shown in the in-app badge (topbar). Source of truth: CI computes
# it as `git rev-list --count HEAD` (full history — see .github/workflows/).
# src/main.ts falls back to "DEV" when unset; set it locally to see a real
# number, e.g. the current `git rev-list --count HEAD`.
VITE_BUILD_NUMBER=

# Short commit SHA shown next to the badge. CI: `git rev-parse --short HEAD`.
# Local fallback is "LOCAL".
VITE_COMMIT_SHA=

# Installer version for desktop builds — CI-only, not read by app code. Derived
# from the same build count, split into semver (v124 -> 1.2.4) by
# scripts/build-version.mjs and injected into the Tauri bundle via a --config
# merge (see desktop.yml).
ULTIPIXELIZER_VERSION=
