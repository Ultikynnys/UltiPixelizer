{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window (and the hidden CLI window)",
  "windows": ["main", "cli"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file"
  ]
}
