{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UltiPixelizer",
  "version": "0.0.0",
  "identifier": "com.ultikynnys.ultipixelizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UltiPixelizer",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Texture pixelation and palette dithering studio",
    "longDescription": "UltiPixelizer: pixelate textures, dither with retro palettes, and bake lighting and ambient occlusion from 3D models — processed entirely on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
